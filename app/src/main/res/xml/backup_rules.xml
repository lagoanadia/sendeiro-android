<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Viaja: ajustes del usuario y borrador del parte -->
    <include domain="sharedpref" path="ajustes.xml" />
    <include domain="sharedpref" path="borrador.xml" />
    <!-- No viaja: rutas re-descargables y token de sesión -->
    <exclude domain="database" path="sendeiro.db" />
    <exclude domain="database" path="sendeiro.db-wal" />
    <exclude domain="database" path="sendeiro.db-shm" />
    <exclude domain="sharedpref" path="sesion.xml" />
</full-backup-content>